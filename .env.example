# AI提供商配置
# 选择AI提供商: auto, claude, gemini
# auto = 自动选择可用的提供商（优先Claude，然后Gemini）
AI_PROVIDER=auto

# Claude API配置
# 获取API密钥: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini API配置
# 获取API密钥: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
# 或使用
# GEMINI_API_KEY=your_gemini_api_key_here

# 数据库配置（可选，默认使用SQLite）
# DATABASE_URL=sqlite:///question_bank.db

# Flask配置（可选）
# FLASK_ENV=development
# FLASK_DEBUG=True
# SECRET_KEY=your-secret-key-here
