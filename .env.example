# OCR语言配置
# ch = 中文（默认，支持中英文混合识别）
# en = 英文（仅英文试卷时使用）
OCR_LANG=ch

# ===== AI提供商配置 =====
# 选择AI提供商: auto, deepseek, qwen, siliconflow, gemini, claude, ollama
# auto = 自动级联选择可用的提供商（DeepSeek→通义千问→硅基流动→Gemini→Claude→Ollama）
# 推荐使用 auto 模式，系统会自动选择最快可用的模型
AI_PROVIDER=auto

# ===== 免费云端模型（推荐，1分钟内完成解析） =====

# DeepSeek（推荐首选）
# 注册送 500 万 tokens，中文能力极强，速度快
# 获取 API Key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 通义千问 / 阿里云 DashScope
# qwen-turbo 永久免费，速度快
# 获取 API Key：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 硅基流动 SiliconFlow
# 注册送 2000 万 tokens，提供 Qwen/DeepSeek/GLM 等多种免费模型
# 获取 API Key：https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# ===== Google Gemini（免费额度） =====
# Gemini 2.0 Flash 免费，每分钟 15 次请求
# 获取 API Key：https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
# 或使用
# GEMINI_API_KEY=your_gemini_api_key_here

# ===== Claude（付费，高端选项） =====
# 获取API密钥: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== Ollama 本地推理（完全免费，无需联网） =====
# 安装: https://ollama.ai
# 启动: ollama serve
# 推荐模型（中文能力强）:
#   ollama pull qwen2.5:7b   (4.4GB，推荐 - 速度和质量平衡)
#   ollama pull qwen2.5:14b  (9GB，更强推理能力)
#   ollama pull qwen2.5:3b   (2GB，轻量级)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# ===== 数据库配置（可选，默认使用SQLite） =====
# DATABASE_URL=sqlite:///question_bank.db

# ===== Flask配置（可选） =====
# FLASK_ENV=development
# FLASK_DEBUG=True
# SECRET_KEY=your-secret-key-here
